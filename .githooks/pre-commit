#!/usr/bin/env bash
# Block oversized files from entering git history.
#
# An extension list in .gitignore always misses the next format. This catches
# anything, regardless of name: a corrupted .pptx, an exported .mov, a stray
# database dump. It exists because an 837 MB PowerPoint reached a commit on
# 2026-08-17 and would have been rejected by GitHub on push.
#
# Activate once per clone:
#   git config core.hooksPath .githooks
#
# Deliberate exception, for the rare file that genuinely belongs:
#   ALLOW_LARGE_FILES=1 git commit ...

set -euo pipefail

MAX_MB=20
MAX_BYTES=$((MAX_MB * 1024 * 1024))

if [ "${ALLOW_LARGE_FILES:-0}" = "1" ]; then
	echo "pre-commit: size guard bypassed (ALLOW_LARGE_FILES=1)" >&2
	exit 0
fi

oversized=""
# Added/copied/modified only. Deletions and pure renames introduce no new blob.
while IFS= read -r -d '' path; do
	[ -f "$path" ] || continue
	size=$(wc -c <"$path" | tr -d ' ')
	if [ "$size" -gt "$MAX_BYTES" ]; then
		oversized="${oversized}$(printf '\n  %8.1f MB  %s' "$((size / 1048576))" "$path")"
	fi
done < <(git diff --cached --name-only --diff-filter=ACM -z)

if [ -n "$oversized" ]; then
	cat >&2 <<EOF
pre-commit: BLOCKED - staged file(s) over ${MAX_MB} MB:${oversized}

Large binaries do not belong in this repo. Options:
  1. Put the file on the shared drive and commit a link instead.
  2. Unstage it:   git restore --staged <path>
  3. If the format should never be committed, add it to .gitignore.
  4. Genuine exception:   ALLOW_LARGE_FILES=1 git commit ...

GitHub rejects any file over 100 MB, so this would fail on push anyway.
EOF
	exit 1
fi
