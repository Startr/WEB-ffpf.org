# Hidden-artifact allowlist: deny dotfiles and dotfolders everywhere in the
# repo unless they are intentionally shared and explicitly included below.
.*
!/.gitignore
!/.gitattributes
!/.editorconfig
!/.pages.yml
# .env.example at any depth (no leading slash). Keep this note on its OWN line —
# gitignore has no inline comments; a trailing comment becomes part of the
# pattern, which silently breaks the negation.
!.*.example

# Shared git hooks. These carry the large-file size guard, so they must travel
# with the repo. Each clone activates them once:
#   git config core.hooksPath .githooks
!/.githooks/
!/.githooks/**

# Obsidian vault config travels with the repo (KANBAN.canvas is edited there,
# via the vendored advanced-slides plugin). workspace.json is per-session
# editor state and must not: it churns on every session.
!/.obsidian/
!/.obsidian/**
/.obsidian/workspace.json

# ---------------------------------------------------------------------------
# Large binaries: never commit these. Put them on the shared drive instead.
# The .githooks/pre-commit size guard is the backstop for formats not listed
# here. An extension list always misses the next one.
# ---------------------------------------------------------------------------

# Presentations and office source documents
*.pptx
*.ppt
*.pptm
*.potx
*.odp
*.key
*.numbers
*.pages

# Design source files
*.psd
*.ai
*.sketch
*.fig
*.xcf
*.indd

# Video and disk images. NOTE: eleventy.config.js passthrough-copies
# **/*.{mp4,webm} as site content. None are tracked today. If you ever add a
# site video, re-include that exact path here rather than dropping the rule.
*.mov
*.mp4
*.webm
*.avi
*.mkv
*.wmv
*.iso
*.dmg

# Archives
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz

# ---------------------------------------------------------------------------
# Non-dot build & runtime junk (preserved from the previous .gitignore)
# ---------------------------------------------------------------------------

# Node
node_modules/
bower_components
jspm_packages/
web_modules/
lib-cov
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
pids
*.pid
*.pid.lock
*.seed
*.lcov
*.tsbuildinfo
coverage
build/Release

# Eleventy / site output
dist
dist/
/site
out
out/
src~

# Python
__pycache__
*.py[cod]
*.pyc
*$py.class
*.egg
*.egg-info/
*.whl
*.manifest
*.spec
develop-eggs/
downloads/
eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
env/
ENV/
env.bak/
venv/
venv.bak/
htmlcov/
coverage.xml
*.cover
nosetests.xml
celerybeat-schedule.*
pip-log.txt
pip-delete-this-directory.txt
*.pot
*.sage.py

# Django / app data
db.sqlite3
media

# Editor and tool cruft (non-dot only; dotfiles are covered by .* above)
*.bak
*.iws
atlassian-ide-plugin.xml
sftp-config.json
GitHub.sublime-settings
*.sublime-project
*.sublime-workspace
*.stTheme.cache
*.tmPreferences.cache
*.tmlanguage.cache
Control.ca-bundle
Control.ca-list
Control.last-run
Control.system-ca-bundle
