<!DOCTYPE html>
<html lang="{{ metadata.language }}">

  <head>
    {% include "./base/head.html" %}
  </head>

  <body style="
      --minh: 100vh;
      --maxw-md: 100vw;
      --m: auto;
      --d: flex;
      --fd: column;
      --jc: space-between;
      --primary: hsl(358deg 84% 52%);
      --links: var(--primary);
      --typo-size-6: 12px;
      font-size: var(--typo-size-5);
      0
    ">

    <script type="text/javascript">
      var _paq = window._paq = window._paq || [];
      /* tracker methods like "setCustomDimension" should be called before "trackPageView" */
      _paq.push([
        "setDocumentTitle", document.domain + "/" + document.title
      ]);
      _paq.push(["setCookieDomain", "*.ffpf.org"]);
      _paq.push(["setDomains", ["*.ffpf.org"]]);
      _paq.push(['trackPageView']);
      _paq.push(['enableLinkTracking']);
      (function () {
        var u = "//visitas.startr.cloud/";
        _paq.push([
          'setTrackerUrl', u + 'matomo.php'
        ]);
        _paq.push(['setSiteId', '7']);
        var d = document,
          g = d.createElement('script'),
          s = d.getElementsByTagName('script')[0];
        g.type = 'text/javascript';
        g.async = true;
        g.src = u + 'matomo.js';
        s
          .parentNode
          .insertBefore(g, s);
      })();
    </script>
    <noscript>
      <p><img src="//visitas.startr.cloud/matomo.php?idsite=7&amp;rec=1" style="border:0;" alt=""/></p>
    </noscript>

    <!-- Sticky only from md up: on a phone the wrapped nav would cover a fifth of the screen. -->
    <header
      style="--z: 1000;
      --bg: var(--white);
      --pos-md: sticky;
      --top: 0;
      --w: 100%;
      user-select: none;">
      <a href="#skip" style="--pos: absolute; --t: translateY(-200%); --t-focus: none; --z: 1001; --bg: var(--white); --p: 0.5em 1em">Skip to main content</a>
      <a class="home-link" style="--d: none" href="/">{{ metadata.title }}</a>
      {% include "./base/nav_en.html" %}
    </header>

    <main style="--m: 0.8rem" id="skip">
      {% if title and big_image %}
        <section aria-roledescription="Title Card">
          <figure style="--br: 5px; --of: hidden; --grad: 0deg; --pos: relative; --w:100%">
            <img src="{{ big_image }}" alt="" style="--minh: 12rem; --objf:cover"/>
            <figcaption style="--d: flex; --fd:column; --jc: center; --ai: center; --inset: 0; --pos: absolute">
              <h1
              style="{% if big_image_offset %}--mt:{{ big_image_offset }};{% endif %} --c: white; --ts: black 1px 0 10px">
                {{ title }}</h1>
              <span style="--c: white; --ts: black 1px 0 10px">
                {{ subtitle }}
              </span>
            </figcaption>
          </figure>
        </section>
      {% endif %}
      <section aria-roledescription="Main Content">{{ content |safe }}</section>
    </main>

    <!-- Footer -->
    <!-- The brand red, darkened, so white text passes contrast (6.7:1).
         Browsers without color-mix() keep the plain brand red. -->
    <footer style="
        background: var(--primary);
        background: color-mix(in srgb, var(--primary) 78%, black);
        --c: white;
        --p: 20px;
      ">
      <nav aria-label="Footer" style="--d: flex; --fw: wrap; --g: 0.5em 1.5em">
        <a style="--c: white" href="/contact/">Contact Us</a>
        <a href="https://www.facebook.com/freedomfrompoverty/" target="_blank" rel="noopener" style="--c: white">Follow us on Facebook</a>
        <a href="https://www.instagram.com/ffpf_org?igsh=MXF4d2tjZGF6dHRhMw==" target="_blank" rel="noopener" style="--c: white">Follow us on Instagram</a>
        <a href="/donate" style="--c: white">Donate</a>
      </nav>
      <p style="--m: 20px 0">
        Freedom From Poverty Foundation<br>
        1333 Stravinski Avenue, Brossard, QC J4X 2C5
      </p>
      <p style="--m: 20px 0">
        La Fondation de la Libération de la Pauvreté Inc. | CRA Registration #: 892570938RR0001
      </p>
      <p style="--m: 20px 0">
        Copyright © Freedom From Poverty Foundation
      </p>
    </footer>
    </body>
    {% include "../plugins/google_translate.html" %}
  </html>